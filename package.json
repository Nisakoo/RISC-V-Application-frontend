{
  "name": "riscv-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:pages": "VITE_BASE=/RISC-V-Application-frontend/ VITE_MOCK_ONLY=true npm run build",
    "deploy": "gh-pages -d dist",
